PORT=3000

# Estes dois sao obrigatorios so na primeira vez que o servidor sobe.
# Depois disso, TUDO abaixo (inclusive estes dois) pode ser visto e
# trocado em /admin -> Configuracoes, sem precisar editar este arquivo
# nem reiniciar o servidor.
JWT_SECRET=troque-isso-por-um-segredo-longo-e-aleatorio
GEMINI_API_KEY=coloque-sua-api-key-do-gemini-aqui

GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_TEXT_MODEL=gemini-3.6-flash
GEMINI_TEXT_FALLBACKS=gemini-3.5-flash,gemini-3.6-flash-lite

# painel /admin: a conta com este e-mail vira admin (pode listar varios separados por virgula)
ADMIN_EMAIL=voce@email.com
# alternativa: senha unica pra entrar no /admin sem conta
ADMIN_PASSWORD=troque-por-uma-senha-forte-para-o-painel-admin

# minutos de conversa por dia pra quem nao assinou
FREE_MINUTES_PER_DAY=3

# Pix via PagBank (PagSeguro): token da conta e ambiente (sandbox | production)
PAGBANK_TOKEN=
PAGBANK_ENV=sandbox
# URL publica https do app, usada pro PagBank avisar quando o Pix foi pago
PUBLIC_URL=
